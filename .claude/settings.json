{
  "permissions": {
    "allow": [
      "Bash(systemctl --user is-active *)",
      "Bash(systemctl --user is-enabled *)",
      "Bash(systemctl --user list-timers *)",
      "mcp__railway__list_projects",
      "mcp__railway__get_service_config"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard_main_worktree.py\""
          },
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/check_destructive_command.py\""
          },
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard_neon.py\""
          },
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard_shared_venv.py\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/dream_stop_reminder.py\""
          }
        ]
      }
    ]
  }
}
