# ABOUTME: systemd --user unit for the Telegraph operator supervisor (deaf-detector Shape 1).
# ABOUTME: Restart=always relaunches the supervisor itself; the supervisor relaunches the operator.
#
# Install (see operator_supervisor.README.md for the full walk-through):
#   mkdir -p ~/.config/systemd/user
#   cp operator-supervisor.service ~/.config/systemd/user/
#   # edit the ExecStart chat id / relaunch command + the EnvironmentFile path below
#   systemctl --user daemon-reload
#   systemctl --user enable --now operator-supervisor.service
#   loginctl enable-linger "$USER"   # keep the --user manager alive across logout
#
# The bot token is read from EnvironmentFile, never embedded here. Keep that file
# 0600 and out of git.

[Unit]
Description=Telegraph operator deaf-detector supervisor
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# The token lives here, not in the unit. chmod 600, never commit it.
EnvironmentFile=%h/.claude/channels/telegram/supervisor.env
# The CLI imports the `oversteward` package; point Python at the repo src
# (an editable `uv sync` install also satisfies this).
Environment=PYTHONPATH=%h/OverSteward/src
# A systemd --user manager starts with a minimal PATH, so `claude` (in
# ~/.local/bin) and `tmux` (/usr/bin) would not resolve. The relaunched operator
# inherits this PATH, so both must be on it (OverSteward #119).
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
# --loop: the supervisor runs continuously, ticking every --poll-interval seconds.
# On each process start it resets its grace window + detection streaks while
# preserving the cooldown ledger (so Restart=always cannot relaunch-loop the
# operator). --session-name names the tmux session the operator runs in (the
# single-instance key); it MUST be passed before --relaunch-cmd, because
# --relaunch-cmd consumes every remaining token (argparse REMAINDER) as the
# operator relaunch command. The supervisor runs that command inside a detached
# `telegraph-operator` tmux session (a pty, so claude runs interactive — systemd
# has no controlling terminal). Requires tmux on PATH (/usr/bin/tmux).
ExecStart=/usr/bin/env python3 %h/OverSteward/shared/scripts/telegraph/operator_supervisor.py \
    --chat-id ${TELEGRAPH_CHAT_ID} \
    --loop \
    --session-name telegraph-operator \
    --relaunch-cmd claude --channels plugin:telegram@claude-plugins-official
Restart=always
RestartSec=10
# Stop signal goes to the supervisor only; the operator lives in the tmux server's
# own session, so it survives a supervisor restart and is evicted explicitly by
# the next relaunch (tmux kill-session) rather than by systemd.
KillMode=process

[Install]
WantedBy=default.target
