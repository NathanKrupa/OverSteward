# ABOUTME: systemd --user unit for the dream-cycle cron BACKSTOP (OverSteward #114).
# ABOUTME: Oneshot headless `claude -p` run; the paired dream-cycle.timer schedules it. NOT enabled by default.
#
# Install (see dream_cycle.README.md for the full walk-through):
#   mkdir -p ~/.config/systemd/user
#   cp dream-cycle.service dream-cycle.timer ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now dream-cycle.timer   # explicit operator step
#   loginctl enable-linger "$USER"                     # keep the timer alive across logout
#
# This is the BACKSTOP only — the sign-off path and the Stop-hook reminder are the
# primary triggers. It no-ops cleanly when the ledger is already current.

[Unit]
Description=Dream cycle backstop — consolidate unprocessed session transcripts
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# Run from the OverSteward working tree so `claude` finds the /dream skill,
# registry, and the oversteward package.
WorkingDirectory=%h/OverSteward
Environment=PYTHONPATH=%h/OverSteward/src
# Headless Claude Code uses the Max SUBSCRIPTION (in-session), NOT the metered
# API — this is a backstop trigger, never an API daemon. The /dream skill is the
# convergent runner; on a current ledger it exits as a clean no-op.
#
# ABSOLUTE path on purpose. A systemd --user manager's PATH is the system default
# (/usr/local/bin:/usr/bin:/bin:/snap/bin) and does NOT carry ~/.local/bin, where
# the Claude Code CLI installs — a bare `claude` never launches. Confirm yours
# with `command -v claude`, and check the unit with
# `systemd-analyze --user verify ~/.config/systemd/user/dream-cycle.service`.
ExecStart=%h/.local/bin/claude -p "Run the dream cycle: follow the /dream skill end to end (memory/docs only, never code). If the ledger is current, no-op."
