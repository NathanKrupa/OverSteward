# ABOUTME: systemd --user timer scheduling the dream-cycle backstop (OverSteward #114).
# ABOUTME: Nightly tick that catches nights with no sign-off; NOT enabled by default (operator enables explicitly).
#
# Enable: systemctl --user enable --now dream-cycle.timer
# Inspect: systemctl --user list-timers dream-cycle.timer

[Unit]
Description=Nightly dream-cycle backstop schedule

[Timer]
# 03:30 local, daily — a quiet hour after most sessions have ended. Persistent
# runs a missed tick once the machine is back up (laptop closed overnight).
OnCalendar=*-*-* 03:30:00
Persistent=true
RandomizedDelaySec=600

[Install]
WantedBy=timers.target
