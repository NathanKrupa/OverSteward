# ABOUTME: systemd --user unit that runs the checkout-currency sync across every managed repo.
# ABOUTME: Paired with sync-repos.timer; NOT enabled by default (operator enables explicitly).
#
# Install:
#   mkdir -p ~/.config/systemd/user
#   cp sync-repos.service sync-repos.timer ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now sync-repos.timer
#   loginctl enable-linger "$USER"     # keep the timer alive across logout
#
# Why a timer at all. sync_repos.py existed for weeks with no caller — no timer,
# no service, no skill invoked it, so checkouts drifted anyway (aigranthelper
# reached 590 commits behind). A hygiene tool that depends on someone
# remembering to run it is a tool that does not run. This is the caller.
#
# Safe to run unattended by construction: sync_repos never touches a dirty tree,
# never touches a checkout sitting on a branch other than its target, and only
# resets a diverged branch when every commit on it is already published on some
# remote. Anything else it reports and leaves alone.

[Unit]
Description=Keep managed checkouts current with origin
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/home/natha/OverSteward
ExecStart=/home/natha/OverSteward/.venv/bin/python scripts/dev/sync_repos.py
# A repo that cannot be reached must not fail the whole sweep; sync_repos
# already reports per-repo and exits 0 on a partial result.
TimeoutStartSec=1800
