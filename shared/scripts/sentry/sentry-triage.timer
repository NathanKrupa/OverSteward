# ABOUTME: systemd --user timer scheduling the sentry-triage backstop (OverSteward #339).
# ABOUTME: Weekly tick that catches weeks with no session-start sweep; NOT enabled by default (operator enables explicitly).
#
# Enable: systemctl --user enable --now sentry-triage.timer
# Inspect: systemctl --user list-timers sentry-triage.timer

[Unit]
Description=Weekly sentry-triage backstop schedule

[Timer]
# Monday 04:30 local, weekly to start — a quiet hour, and the head of the week,
# so anything the backstop files is waiting when the week's first session opens.
# Persistent runs a missed tick once the machine is back up (laptop closed).
OnCalendar=Mon *-*-* 04:30:00
Persistent=true
RandomizedDelaySec=1800

[Install]
WantedBy=timers.target
