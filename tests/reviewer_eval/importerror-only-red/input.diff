     for row in rows:
         Export.objects.create(org=org, payload=row)
     return len(rows)
diff --git a/tests/services/test_quota.py b/tests/services/test_quota.py
new file mode 100644
index 0000000..ddddddd
--- /dev/null
+++ b/tests/services/test_quota.py
@@ -0,0 +1,19 @@
+from __future__ import annotations
+
+import pytest
+
+from pkg.services.quota import DEFAULT_QUOTA, QuotaExceeded, check_quota
+
+
+def test_under_the_quota_is_allowed():
+    check_quota(used=3)
+
+
+def test_at_the_quota_is_refused():
+    with pytest.raises(QuotaExceeded):
+        check_quota(used=DEFAULT_QUOTA)
+
+
+def test_the_default_quota_is_one_hundred():
+    assert DEFAULT_QUOTA == 100
