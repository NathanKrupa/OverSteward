+# ABOUTME: Enforces the per-organization monthly export quota.
+# ABOUTME: Called by the export view before any row is written.
+
+from __future__ import annotations
+
+DEFAULT_QUOTA = 100
+
+
+class QuotaExceeded(RuntimeError):
+    """The organization has spent its monthly export allowance."""
+
+
+def check_quota(used: int, limit: int = DEFAULT_QUOTA) -> None:
+    """Refuse an export once the allowance is spent."""
+    if used >= limit:
+        raise QuotaExceeded(f"{used} of {limit} exports used this month")
