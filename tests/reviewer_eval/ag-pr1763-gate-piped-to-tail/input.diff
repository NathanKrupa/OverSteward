+# Keep the verify log readable — the suite prints thousands of lines and the
+# interesting part is always at the end.
 run_gate "tests"
-pytest -q
+pytest -q 2>&1 | tail -20
 rc=$?
 if [ "$rc" -ne 0 ]; then
   echo "verify: tests failed"
   exit 1
