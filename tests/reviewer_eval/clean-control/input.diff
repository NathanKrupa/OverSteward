diff --git a/src/pkg/services/slugify.py b/src/pkg/services/slugify.py
index 1111111..2222222 100644
--- a/src/pkg/services/slugify.py
+++ b/src/pkg/services/slugify.py
@@ -12,8 +12,14 @@ _NON_ALNUM = re.compile(r"[^a-z0-9]+")


 def slugify(name: str) -> str:
-    """Lowercase ``name`` and join its word characters with hyphens."""
-    return _NON_ALNUM.sub("-", name.lower()).strip("-")
+    """Lowercase ``name`` and join its word characters with hyphens.
+
+    An empty result would produce a URL that collides with the collection
+    route, so a name carrying no alphanumerics falls back to a stable
+    placeholder rather than to the empty string.
+    """
+    slug = _NON_ALNUM.sub("-", name.lower()).strip("-")
+    return slug or "untitled"
diff --git a/tests/services/test_slugify.py b/tests/services/test_slugify.py
