@@ -1,5 +1,7 @@
 from __future__ import annotations

+import pytest
+
 from pkg.services.slugify import slugify


@@ -14,3 +16,13 @@ def test_punctuation_becomes_a_single_hyphen():

 def test_leading_and_trailing_hyphens_are_trimmed():
     assert slugify("  Hello  ") == "hello"
+
+
+@pytest.mark.parametrize("name", ["", "   ", "!!!", "—"])
+def test_a_name_with_no_alphanumerics_falls_back_to_untitled(name):
+    # Without the fallback each of these returns "", which routes to the
+    # collection URL instead of the detail URL.
+    assert slugify(name) == "untitled"
+
+
+def test_an_ordinary_name_is_unaffected_by_the_fallback():
+    assert slugify("Acme Foundation") == "acme-foundation"
