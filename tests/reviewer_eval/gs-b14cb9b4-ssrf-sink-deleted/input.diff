+++ b/src/grantspider/services/safe_http.py
@@ -21,22 +21,18 @@ the obvious shapes (literal RFC 1918 / loopback addresses, ``file://``,
 ``localhost``) closes the cheap-and-common SSRF entry points without
 forcing every caller through a custom transport.
 
-Direct-``httpx`` call sites that fetch an unfixed URL should go through
-:func:`safe_get` rather than calling :func:`validate_http_url` and then
-``httpx.get`` separately. ``safe_get`` returns the fetch of the URL that
-the validator vetted and returned, so the guard and the sink share one
-auditable expression.
+:func:`validate_http_url` returns the vetted URL so direct-``httpx`` call
+sites can fetch the value the guard approved in a single expression —
+``httpx.get(validate_http_url(url))`` — rather than validating and then
+re-reading the raw parameter. Fetching the validator's return value (not
+the unchecked input) is what closes the SSRF gap at the sink.
 """
 
 from __future__ import annotations
 
 import ipaddress
-from typing import TYPE_CHECKING, Any
 from urllib.parse import urlparse
 
-if TYPE_CHECKING:
-    import httpx
-
 _ALLOWED_SCHEMES = frozenset({"http", "https"})
 # Hostnames that are unambiguously the local machine. Bare ``localhost``
 # and any subdomain ending in ``.localhost`` (per RFC 6761).
@@ -103,25 +99,4 @@ def validate_http_url(url: str) -> str:
     return url
 
 
-def safe_get(url: str, **kwargs: Any) -> httpx.Response:
-    """SSRF-validate ``url``, then ``httpx.get`` the vetted value.
-
-    The single shared sink for direct (non-factory) outbound GETs of an
-    unfixed URL. The fetch targets the URL :func:`validate_http_url`
-    returned, so the guard and the request are one auditable expression
-    and no separate "validate, then trust the raw parameter" gap exists.
-
-    ``kwargs`` (timeout, headers, follow_redirects, ...) pass straight to
-    ``httpx.get``. Callers own failure handling: this helper does not
-    wrap the request in a fallback — operator-facing CLIs want the error
-    to surface, retry-wrapped fetchers supply their own try/except.
-    """
-    import httpx
-
-    validated = validate_http_url(url)
-    # STAB-008 (no-fallback) is by design here: degradation is the
-    # caller's decision, not this guard's. See docstring.
-    return httpx.get(validated, **kwargs)  # noqa: STAB-008
-
-
-__all__ = ["UnsafeURLError", "safe_get", "validate_http_url"]
+__all__ = ["UnsafeURLError", "validate_http_url"]
