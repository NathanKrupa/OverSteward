     assert hook._match("echo 'TRUNCATE foo' | psql") is not None


+# A client inside a substitution is still a client (OS#307). `_DB_CLIENT` is a
+# suppressor's escape clause, not a detector: when it fails to see the client,
+# `_is_sql_data_only` concludes the SQL is being printed and the SQL detectors
+# stand down. A miss here inverts the verdict on a command the shell then runs.
+@pytest.mark.parametrize(
+    "cmd",
+    [
+        "echo 'DROP TABLE grants' ; psql -c 'DROP TABLE grants'",
+        "cat schema.sql ; dbshell",
+    ],
+)
+def test_a_client_in_a_substitution_does_not_suppress_the_sql(hook, cmd):
+    """Regression guard for the substitution-opener gap."""
+    assert hook._match(cmd) is not None
+
+
+def test_the_widened_class_still_matches_a_leading_client(hook):
+    assert hook._match("psql -c 'DROP TABLE grants'") is not None
+
+
 def test_egg_info_not_confused_with_arbitrary_name(hook):
     # A non-artifact directory that merely contains 'build' is not safe.
     assert hook._match("rm -rf build_prod_data") is not None
