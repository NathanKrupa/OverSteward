#!/usr/bin/env bash
# ABOUTME: Pre-commit hook shim, lives under core.hooksPath so it travels
# ABOUTME: with the repo. Worktrees inherit it; no per-checkout install.
#
# Why this file is checked in
# ---------------------------
# `pre-commit install` writes its hook to `.git/hooks/` (or, in a
# worktree, `.git/worktrees/<name>/hooks/`). That's per-checkout state.
# Dispatch agents that `git worktree add` a fresh tree don't carry the
# parent's hook install, so the gate silently goes missing.
#
# This shim lives in `.githooks/` and `make hooks` sets
# `core.hooksPath=.githooks` — a per-repo setting worktrees DO inherit.
# A new worktree picks up this hook automatically, no install step.
#
# Mirrors aigranthelper/.githooks/pre-commit and grantspider/.githooks/pre-commit.

set -e

# Diverges from the aigranthelper/grantspider shims on purpose. Those assume an
# activated venv puts `pre-commit` on PATH. OverSteward is uv-managed and its
# CLAUDE.md tells you to run everything through `uv run`, so a PATH-only lookup
# means the gate skips itself on the normal workflow — which is precisely how
# this repo ended up with a declared-but-never-enforced gate.
#
# Nothing here may re-sync the environment. A worktree's .venv is a symlink to
# the primary checkout's, so a bare `uv run` on the commit path rebinds the
# shared editable install to whichever worktree committed, leaving the primary
# checkout — where the resident operator session runs — importing a session
# branch's source. Hence: prefer the venv binary directly, and pass --no-sync
# when uv is the only route.
repo_root="$(git rev-parse --show-toplevel)"

# The hooks are `language: system`, so they resolve `python` from PATH. Putting
# the venv first is what an activated venv would do — and is required now that
# this shim no longer goes through `uv run` (which used to supply it as a side
# effect of the re-sync we are avoiding).
if [ -d "$repo_root/.venv/bin" ]; then
    PATH="$repo_root/.venv/bin:$PATH"
    export PATH
fi

if [ -x "$repo_root/.venv/bin/pre-commit" ]; then
    runner=("$repo_root/.venv/bin/pre-commit")
elif command -v pre-commit >/dev/null 2>&1; then
    runner=(pre-commit)
elif command -v uv >/dev/null 2>&1; then
    runner=(uv run --no-sync --quiet pre-commit)
else
    echo "[pre-commit] no pre-commit available — skipping. Install with: uv sync --extra dev" >&2
    exit 0
fi

exec "${runner[@]}" hook-impl \
    --config=.pre-commit-config.yaml \
    --hook-type=pre-commit \
    --hook-dir "$(cd "$(dirname "$0")" && pwd)" \
    --skip-on-missing-config \
    -- "$@"
