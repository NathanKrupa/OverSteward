# ABOUTME: systemd --user unit that runs the abandoned-work sweep, then writes the nightly Estate Brief.
# ABOUTME: Paired with estate-brief.timer; the morning check-in skill reads the note it writes.
#
# Install (once per machine):
#   mkdir -p ~/.config/systemd/user
#   cp ops/wsl/estate-brief.service ops/wsl/estate-brief.timer ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemd-analyze --user verify ~/.config/systemd/user/estate-brief.service
#   systemctl --user enable --now estate-brief.timer
#   systemctl --user start estate-brief.service   # one run now; then read the note
#
# The check-in skill reads vault files only, so this note is its whole view of
# the estate; it reports "the nightly estate brief did not run" when the note's
# date is more than two days old. Exit 1 (GitHub or the vault unreadable, or
# the Railway sweep blind) leaves the unit failed; `journalctl --user -u
# estate-brief` names the cause. A blind Railway sweep still writes the note,
# with the blind source under URGENT.
#
# The abandoned-work sweep (#612) runs first, as ExecStartPre, and appends what
# it decided to the ledger at $SHELVE_LEDGER_PATH; the brief's "Shelved
# overnight" reads that ledger. The leading "-" keeps a failed sweep from
# stopping the brief: the brief then finds no completed run in its window, says
# so in the note, and exits 1, so the failure still shows on the unit.
#
# The sweep runs in DRY-RUN: it writes nothing to GitHub, and the brief renders
# its lines as "would shelve …". Switching it to act is one change, made only
# after Nathan has read a dry-run sample and approved it: append " --apply" to
# the ExecStartPre line, copy this file to ~/.config/systemd/user/ and run
# `systemctl --user daemon-reload`. --apply refuses (exit 2, nothing written)
# in any repository that lacks the `shelved` label.

[Unit]
Description=Write the nightly Estate Brief into the vault
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/home/natha/OverSteward
Environment=PYTHONPATH=/home/natha/OverSteward/src
# The user manager's PATH is the system default and does not carry
# ~/.railway/bin, where the railway CLI the liveness sweep runs is installed.
Environment=PATH=/home/natha/.railway/bin:/usr/local/bin:/usr/bin:/bin
Environment=SHELVE_LEDGER_PATH=/home/natha/.local/state/oversteward/shelve-ledger.jsonl
ExecStartPre=-/home/natha/OverSteward/.venv/bin/python /home/natha/OverSteward/scripts/shelve_sweep.py
ExecStart=/home/natha/OverSteward/.venv/bin/python /home/natha/OverSteward/scripts/estate_brief.py --out "/mnt/c/Users/natha/OneDrive/Documents/Nathan Writing/Obsidian/GTD/Estate Brief.md"
TimeoutStartSec=15min
