ABOUTME: Git ignore rules for the OverSteward repository.
ABOUTME: Keeps reports archive, Python cache, and environment files out of version control.

# Reports archive (older than 30 days — kept on disk, not in git)
reports/archive/

# Python
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/
*.egg-info/
dist/
build/
.eggs/

# Environment
.env
.env.local
*.env

# Worktree bootstrap artifacts written by scripts/dev/new-session.sh. The primary
# .venv self-ignores (uv writes .venv/.gitignore), but a worktree's is a symlink
# git cannot descend into — so every session tree carried them as strays (OS#255).
.envrc
.venv

# OS
.DS_Store
Thumbs.db

# Test artifacts
.coverage
htmlcov/

# Claude Code local/session settings (settings.json is team-shared — tracked)
.claude/settings.local.json

# Skill runtime state (ephemeral per-machine)
.claude/skills/*/state.json

# Editor
.vscode/settings.json
*.swp

# Scheduled task lockfile + crash dumps
.claude/scheduled_tasks.lock
*.stackdump

# Per-machine pipeline snapshot log (append-only observability)
data/pipeline_history.jsonl

# Per-machine dream-cycle processed-transcript ledger (append-only idempotency)
data/dream/processed_transcripts.jsonl

# Per-machine dream-cycle flagged open set (held items, drained explicitly)
data/dream/flagged.jsonl
# Promotion-pass run ledger (OS#325) — runtime state, like its siblings above.
data/dream/promotion.json

# Per-machine kaizen verdict ledger (OS#332) — what has been ruled on
data/dream/kaizen.json

# Dispatch agent worktrees (registered git worktrees, ephemeral per-machine)
.claude/worktrees/

# Local scratch / draft issue bodies / throwaway notes
.scratch/

# Per-machine session handoff scratchpad — durable handoff lives in memory + GH
# issues, never committed to master. See CLAUDE.md § Session handoff (OS#90).
SESSION_STATE.md

# Repo-local scratch working dir (audit drafts, issue scratch) — not durable docs
scratchpad/
