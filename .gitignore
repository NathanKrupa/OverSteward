ABOUTME: Git ignore rules for the OverSteward repository.
ABOUTME: Keeps reports archive, Python cache, and environment files out of version control.

# Reports archive (older than 30 days — kept on disk, not in git)
reports/archive/

# Python
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/
*.egg-info/
dist/
build/
.eggs/

# Environment
.env
.env.local
*.env

# OS
.DS_Store
Thumbs.db

# Test artifacts
.coverage
htmlcov/

# Claude Code local/session settings (settings.json is team-shared — tracked)
.claude/settings.local.json

# Skill runtime state (ephemeral per-machine)
.claude/skills/*/state.json

# Editor
.vscode/settings.json
*.swp

# Scheduled task lockfile + crash dumps
.claude/scheduled_tasks.lock
*.stackdump

# Per-machine pipeline snapshot log (append-only observability)
data/pipeline_history.jsonl

# Per-machine dream-cycle processed-transcript ledger (append-only idempotency)
data/dream/processed_transcripts.jsonl

# Dispatch agent worktrees (registered git worktrees, ephemeral per-machine)
.claude/worktrees/

# Local scratch / draft issue bodies / throwaway notes
.scratch/

# Per-machine session handoff scratchpad — durable handoff lives in memory + GH
# issues, never committed to master. See CLAUDE.md § Session handoff (OS#90).
SESSION_STATE.md
